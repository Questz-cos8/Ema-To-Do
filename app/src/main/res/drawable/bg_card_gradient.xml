<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页卡片底：藕粉→米白→淡紫，斜向渐变，不再是死白 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#FFF0F5"
        android:centerColor="#FFFCFD"
        android:endColor="#F4F0FA"
        android:type="linear" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="#1FB08A98" />
</shape>
