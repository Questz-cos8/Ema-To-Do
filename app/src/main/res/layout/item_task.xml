<?xml version="1.0" encoding="utf-8"?>
<!-- 一行式紧凑卡：圆点 · 标题 · 标签圆点 · DDL · 完成；左滑露出删除 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap">

    <!-- 左滑时露出来的删除底 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_delete_reveal"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/swipe_delete_hint"
            android:textColor="@color/primary"
            android:textSize="12.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="🗑"
            android:textSize="16sp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/card_overlay"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0dp"
        app:strokeColor="@color/stroke"
        app:strokeWidth="1dp">

        <FrameLayout
            android:id="@+id/cardImageWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row_min_height">

            <com.todolife.app.ui.CardImageView
                android:id="@+id/imgCardBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/action_pick_card_bg"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="8dp">

                <com.todolife.app.ui.DotView
                    android:id="@+id/dot"
                    android:layout_width="@dimen/dot_size_big"
                    android:layout_height="@dimen/dot_size_big"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="任务标题"
                            android:textColor="@color/text_primary"
                            android:textSize="14.5sp" />

                        <TextView
                            android:id="@+id/tvPin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:text="📌"
                            android:textSize="10sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tagDots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/tvDeadline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:paddingStart="6dp"
                            android:singleLine="true"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 进度：贴在日期正左边，垂直居中，不跟其他文字挤在一行 -->
                <TextView
                    android:id="@+id/tvStage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:textColor="@color/text_hint"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/tvDeadlineDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:maxWidth="96dp"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnCardDone"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_done_ring"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
